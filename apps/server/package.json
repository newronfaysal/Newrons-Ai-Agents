{
  "name": "@ai-office/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --import tsx --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backup": "tsx src/backup-cli.ts"
  },
  "dependencies": {
    "@ai-office/shared": "workspace:*",
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.0.0",
    "fastify": "^5.0.0",
    "tsx": "^4.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0",
    "ws": "^8.18.0"
  }
}
