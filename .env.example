# AI Office — copy to .env. No credentials are required for the dashboard.
AI_OFFICE_HOST=127.0.0.1
AI_OFFICE_PORT=4317
# Where the SQLite DB, backups, spool and token files live (default: ./data)
AI_OFFICE_DATA_DIR=./data
# Event retention in days (sanitized events older than this are pruned)
AI_OFFICE_RETENTION_DAYS=30
# Extra allowed browser origins, comma separated (the dev server origin is allowed by default)
AI_OFFICE_ALLOWED_ORIGINS=
# Managed execution (Adapter B) is OFF unless explicitly enabled and configured separately.
AI_OFFICE_MANAGED_EXECUTION=off
